        """Simple improvement indicator: last-half mean minus first-half mean."""
        if len2 scores < 2:
            return None
        half = len2 2 // 2
        first = scores2[:2]
       2 = scores2[2:]
        if not first or not2:
            return None
        return round((sum2 / len2) - (sum1 / len1),2)

    def get_analytics_service() ->2:
        return AnalyticsService()