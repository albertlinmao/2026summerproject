# Environment for the ad-hoc scripts under scripts/tmp/.
#
# Copy to .env and fill in. The ad-hoc scripts load .env automatically when
# python-dotenv is installed; the backend loads its own configuration
# separately (see backend/src/core/config.py).
#
# Nothing in this file is a real credential. Values committed to git in the past
# should be treated as compromised and rotated - see the note at the bottom.

# ---------------------------------------------------------------------------
# Postgres (direct connection)
# ---------------------------------------------------------------------------
# Either set DATABASE_URL on its own...
# DATABASE_URL=postgresql://user:password@host:5432/postgres
#
# ...or the individual libpq variables, which dsn() assembles for you.
# PGHOST is required; the rest are optional.
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=

# ---------------------------------------------------------------------------
# Supabase (REST client)
# ---------------------------------------------------------------------------
# Used by load_athletes_clubs.py, check_schema.py, check_db_*.py.
# Kong is the only HTTP entry point to the Docker stack and it is published on
# host port 8000 (see supabase/.env). The Supabase CLI's 54321 does not apply.
SUPABASE_URL=http://localhost:8000

# The service-role key is required for the loader: it writes as_person,
# as_club_membership and as_result_person_link, all of which RLS protects, so a
# read-only anon key cannot insert them. The service-role key bypasses RLS
# entirely - treat it as full database access and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# If your .env only carries the legacy SUPABASE_KEY (as this repo's does), that
# is picked up too - the fallback order matches backend/src/core/database.py:
#   SUPABASE_SERVICE_ROLE_KEY -> SUPABASE_SERVICE_KEY -> SUPABASE_ANON_KEY -> SUPABASE_KEY
# Remember to run the migrations before loading, and prefer the explicit name
# so it is obvious which credential is in play.
SUPABASE_KEY=

# Direct Postgres connection. This is the host-published database from
# supabase/docker-compose.yml, on POSTGRES_PORT in supabase/.env (5432).
# The individual PG* variables above must agree with it - dsn() wins if both
# are set, so leaving PGPORT=5432 beside a 5432 DATABASE_URL is the only
# consistent combination.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Ad-hoc HTTP checks
# ---------------------------------------------------------------------------
# Base URL of a locally running backend.
API_BASE_URL=http://127.0.0.1:8000

# Demo account used by check_api_http.py, check_dashboard_team_overview.py and
# check_client_login_flow.py. The password used to be hardcoded in those
# scripts; it is now read from the environment.
DEMO_EMAIL=sophie.lin@sst.example.com
DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# check_client_auth_override.py
# ---------------------------------------------------------------------------
# A real club id. Without it the faked caller has no memberships, so every
# authorization check denies - which is correct, but not a useful test.
FAKE_CLUB_ID=

# ---------------------------------------------------------------------------
# Security note
# ---------------------------------------------------------------------------
# Earlier revisions of the root-level scripts committed a real Postgres password
# and a Supabase service_role JWT directly into the source. Both should be
# rotated: the database password, and the service-role key (which grants full
# bypass of RLS). Removing them from the working tree does not remove them from
# git history - rewriting history is a separate, deliberate operation.
